# ===================================================================
# DEZAN DIGITIZING — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or use these variables in your deployment settings
# ===================================================================

# -------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Authentication, Firestore, Storage)
# -------------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=dezan-digitizing.firebaseapp.com
FIREBASE_PROJECT_ID=dezan-digitizing
FIREBASE_STORAGE_BUCKET=dezan-digitizing.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# -------------------------------------------------------------------
# 2. PAYPAL INTEGRATION (Order Payments & Invoicing)
# -------------------------------------------------------------------
# Use 'sb' or sandbox client ID for testing, replace with live ID for production
PAYPAL_CLIENT_ID=sb
PAYPAL_CURRENCY=USD

# -------------------------------------------------------------------
# 3. EMAILJS NOTIFICATIONS (Automated Email Alerts)
# -------------------------------------------------------------------
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# -------------------------------------------------------------------
# 4. ADMIN & BUSINESS NOTIFICATION CONTACTS
# -------------------------------------------------------------------
ADMIN_EMAIL=fdezan91@gmail.com
ADMIN_NAME=Faisal Dezan
