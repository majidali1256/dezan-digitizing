{
    "name": "dezan-digitizing",
    "main": "payment-worker.mjs",
    "compatibility_date": "2026-09-13",
    "vars": {
        "PAYPAL_MODE": "live",
        "PAYPAL_CURRENCY": "USD"
    },
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": ["/api/paypal/*"]
    }
}
